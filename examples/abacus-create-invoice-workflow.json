              "quantity": 1,
              "unitPrice": 2500,
              "taxCode": "VAT"
            }
          ]
        }
      },
      "id": "abacus-invoice",
      "name": "Abacus ERP",
      "type": "n8n-nodes-abacus-erp.abacusErp",
      "typeVersion": 1,
